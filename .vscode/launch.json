{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular: Launch app (built-in browser)",
      "type": "pwa-chrome",
      "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:/*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "/*": "*"
      },
      "serverReadyAction": {
        "pattern": "Angular Live Development Server is listening on|Compiled successfully|Local:",
        "uriFormat": "http://localhost:4200",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Angular: Launch Brave",
      "type": "pwa-chrome",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:/*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "/*": "*"
      },
      "serverReadyAction": {
        "pattern": "Angular Live Development Server is listening on|Compiled successfully|Local:",
        "uriFormat": "http://localhost:4200",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Angular: Attach to running browser",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:/*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "/*": "*"
      }
    },
    {
      "name": "Angular: Karma tests",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:/*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "/*": "*"
      }
    }
  ]
}
